<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MyBandApp.Models.Presentation"
             x:Class="MyBandApp.Views.SetlistEditPage"
             BackgroundColor="#0F1115"
             Title="Configuration de la Setlist">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="16" RowSpacing="12">

        <!-- 1. Infos de la Setlist -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Configuration de la Setlist" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
            <Entry Placeholder="Nom de la setlist (ex: Live au Bikini)"
                   Text="{Binding SetlistName}"
                   BackgroundColor="#1A1D24"
                   TextColor="White"
                   PlaceholderColor="#64748B" />
            <DatePicker Date="{Binding SetlistDate}" TextColor="White" BackgroundColor="#1A1D24" />
        </VerticalStackLayout>

        <!-- 2. Boutons d'onglets -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="8">
            <Button x:Name="Tab1Button" Grid.Column="0" Text="Morceaux du Set" Clicked="OnTab1Clicked" BackgroundColor="#F59E0B" TextColor="#0F1115" FontAttributes="Bold" CornerRadius="10" />
            <Button x:Name="Tab2Button" Grid.Column="1" Text="Catalogue &amp; Recherche" Clicked="OnTab2Clicked" BackgroundColor="#1A1D24" TextColor="#94A3B8" FontAttributes="Bold" CornerRadius="10" />
        </Grid>

        <!-- 3. Contenu dynamique -->
        <Grid Grid.Row="2">

            <!-- VUE 1 : Morceaux sélectionnés avec vrai Glisser-Déposer -->
            <VerticalStackLayout x:Name="View1Layout" Spacing="10" IsVisible="True">
                <Label Text="Conduite du concert (Maintiens un élément et glisse-le sur un autre pour l'échanger) :" FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" />
                <CollectionView ItemsSource="{Binding SelectedSongs}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="Aucun morceau dans ce set" FontSize="15" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Center" />
                            <Label Text="Va dans l'onglet 'Catalogue &amp; Recherche' pour en ajouter !" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableSongModel">
                            <Border BackgroundColor="#1A1D24" Stroke="#262B36" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">

                                <!-- Configuration du Drag & Drop sur toute la carte -->
                                <Border.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnDragStarting" />
                                    <DropGestureRecognizer AllowDrop="True" Drop="OnDrop" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center" ColumnSpacing="12">
                                    <!-- Numéro d'ordre -->
                                    <Label Grid.Column="0" Text="{Binding DisplayIndex, StringFormat='{0}.'}" FontSize="15" FontAttributes="Bold" TextColor="#F59E0B" VerticalOptions="Center" WidthRequest="25" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Song.Title}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" />
                                        <Label Text="{Binding Song.Artist}" FontSize="13" TextColor="#94A3B8" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="{Binding Song.Key}" FontSize="13" FontAttributes="Bold" TextColor="#C4B5FD" VerticalOptions="Center" />

                                    <!-- Bouton de suppression épuré -->
                                    <Button Grid.Column="3" Text="✕" Clicked="OnRemoveSongClicked" CommandParameter="{Binding .}" BackgroundColor="#EF4444" TextColor="White" WidthRequest="36" HeightRequest="36" CornerRadius="18" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- VUE 2 : Catalogue et recherche corrigée -->
            <VerticalStackLayout x:Name="View2Layout" Spacing="10" IsVisible="False">
                <SearchBar Placeholder="Rechercher un morceau, un artiste..."
                           TextChanged="OnSearchTextChanged"
                           BackgroundColor="#1A1D24"
                           TextColor="White"
                           PlaceholderColor="#64748B" />

                <CollectionView ItemsSource="{Binding FilteredCatalogueSongs}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableSongModel">
                            <Border BackgroundColor="#1A1D24" Stroke="#262B36" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSongCardTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" ColumnSpacing="12">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Color="#F59E0B" CheckedChanged="OnCheckBoxChanged" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Song.Title}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" />
                                        <Label Text="{Binding Song.Artist}" FontSize="13" TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Song.Key}" FontSize="13" FontAttributes="Bold" TextColor="#C4B5FD" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </Grid>

        <!-- 4. Boutons d'action -->
        <HorizontalStackLayout Grid.Row="3" Spacing="12" HorizontalOptions="Center" Margin="0,10,0,0">
            <Button Text="Enregistrer" Clicked="OnSaveClicked" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="150" />
            <Button Text="Annuler" Clicked="OnCancelClicked" BackgroundColor="#334155" TextColor="White" CornerRadius="10" WidthRequest="120" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>