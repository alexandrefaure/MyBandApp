<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyBandApp.ViewModels"
             xmlns:models="clr-namespace:MyBandApp.Models.Presentation"
             x:Class="MyBandApp.Views.SetlistEditPage"
             x:DataType="vm:SetlistEditViewModel"
             BackgroundColor="#0F1115"
             Title="Configuration de la Setlist">

    <ContentPage.Resources>
        <Style x:Key="SelectedSongsTabButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1A1D24" />
            <Setter Property="TextColor" Value="#94A3B8" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectedSongsTab}" TargetType="Button" Value="True">
                    <Setter Property="BackgroundColor" Value="#F59E0B" />
                    <Setter Property="TextColor" Value="#0F1115" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CatalogueTabButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1A1D24" />
            <Setter Property="TextColor" Value="#94A3B8" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCatalogueTab}" TargetType="Button" Value="True">
                    <Setter Property="BackgroundColor" Value="#F59E0B" />
                    <Setter Property="TextColor" Value="#0F1115" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *, Auto, Auto" Padding="16" RowSpacing="12">

        <!-- 1. Infos de la Setlist -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="Configuration de la Setlist" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" />
            <Entry Placeholder="Nom de la setlist (ex: Live au Bikini)"
                   Text="{Binding SetlistName}"
                   BackgroundColor="#1A1D24"
                   TextColor="White"
                   PlaceholderColor="#64748B" />
            <DatePicker Date="{Binding SetlistDate}" TextColor="White" BackgroundColor="#1A1D24" />
        </VerticalStackLayout>

        <!-- 2. Boutons d'onglets -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Morceaux du Set" Command="{Binding ShowSelectedSongsTabCommand}" Style="{StaticResource SelectedSongsTabButton}" />
            <Button Grid.Column="1" Text="Répertoire" Command="{Binding ShowCatalogueTabCommand}" Style="{StaticResource CatalogueTabButton}" />
        </Grid>

        <!-- 3. Contenu dynamique -->
        <Grid Grid.Row="2">

            <!-- VUE 1 : Morceaux sélectionnés avec vrai Glisser-Déposer -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsSelectedSongsTab}">
                <Label Text="Conduite du concert (Maintiens un élément et glisse-le sur un autre pour l'échanger) :" FontSize="12" FontAttributes="Bold" TextColor="#F59E0B" />
                <CollectionView ItemsSource="{Binding SelectedSongs}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8" Padding="24">
                            <Label Text="Aucun morceau dans ce set" FontSize="15" FontAttributes="Bold" TextColor="#94A3B8" HorizontalOptions="Center" />
                            <Label Text="Va dans l'onglet 'Catalogue &amp; Recherche' pour en ajouter !" FontSize="13" TextColor="#64748B" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableSongModel">
                            <Border BackgroundColor="#1A1D24" Stroke="#262B36" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">

                                <!-- Configuration du Drag & Drop sur toute la carte -->
                                <Border.GestureRecognizers>
                                    <DragGestureRecognizer DragStarting="OnDragStarting" />
                                    <DropGestureRecognizer AllowDrop="True" Drop="OnDrop" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center" ColumnSpacing="8">
                                    <!-- Numéro d'ordre -->
                                    <Label Grid.Column="0"
                                           Text="{Binding DisplayIndex, StringFormat='{0}.'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#F59E0B"
                                           VerticalOptions="Center"
                                           WidthRequest="24" />

                                    <!-- Titre et Artiste -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Artist}" FontSize="13" TextColor="#94A3B8" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Bouton Modifier le morceau -->
                                    <Button Grid.Column="2"
                                            Text="✎"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SetlistEditViewModel}}, Path=EditSongCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#262B36"
                                            TextColor="#F8FAFC"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="18"
                                            FontSize="15"
                                            Padding="0" />

                                    <!-- Bouton Supprimer du set -->
                                    <Button Grid.Column="3"
                                            Text="✕"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SetlistEditViewModel}}, Path=RemoveSongCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#EF4444"
                                            TextColor="White"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            CornerRadius="18"
                                            FontSize="14"
                                            Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- VUE 2 : Catalogue et recherche corrigée -->
            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsCatalogueTab}">
                <SearchBar Placeholder="Rechercher un morceau, un artiste..."
                Text="{Binding SearchText}"
               BackgroundColor="#1A1D24"
               TextColor="White"
               PlaceholderColor="#64748B" />

                <CollectionView ItemsSource="{Binding FilteredCatalogueSongs}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SelectableSongModel">
                            <Border BackgroundColor="#1A1D24" Stroke="#262B36" StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SetlistEditViewModel}}, Path=ToggleSongSelectionCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto" VerticalOptions="Center" ColumnSpacing="10">
                                    <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsSelected}"
                                  InputTransparent="True"
                                  Color="#F59E0B"
                                  VerticalOptions="Center" />

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="#F8FAFC" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Artist}" FontSize="13" TextColor="#94A3B8" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>

                                    <!-- Durée du morceau (mm:ss) -->
                                    <Label Grid.Column="2"
                               Text="{Binding FormattedDuration}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#38BDF8"
                               VerticalOptions="Center" />

                                    <!-- Bouton Modifier le morceau -->
                                    <Button Grid.Column="3"
                                Text="✎"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SetlistEditViewModel}}, Path=EditSongCommand}"
                                CommandParameter="{Binding .}"
                                BackgroundColor="#262B36"
                                TextColor="#F8FAFC"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="18"
                                FontSize="15"
                                Padding="0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </Grid>

        <!-- 4. Bandeau durée totale (visible sur les deux onglets) -->
        <Border Grid.Row="3"
                BackgroundColor="#1A1D24"
                Stroke="#262B36"
                StrokeShape="RoundRectangle 10"
                Padding="12,8"
                Margin="0,4,0,0">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="Durée totale du set"
                       FontSize="13"
                       TextColor="#94A3B8"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding TotalDurationText}"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="#38BDF8"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- 5. Boutons d'action -->
        <HorizontalStackLayout Grid.Row="4" Spacing="12" HorizontalOptions="Center" Margin="0,10,0,0">
            <Button Text="Enregistrer" Command="{Binding SaveCommand}" BackgroundColor="#10B981" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="150" />
            <Button Text="Annuler" Command="{Binding CancelCommand}" BackgroundColor="#334155" TextColor="White" CornerRadius="10" WidthRequest="120" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>