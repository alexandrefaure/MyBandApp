<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="ReactiveUI.Maui" Version="26.0.1" />
    <PackageReference Include="Supabase" Version="8.12.0" />
    <PackageReference Include="Supabase.Postgrest" Version="8.12.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="DependencyInjection\**\*.cs" />
    <Compile Include="Services\**\*.cs" />
    <Compile Include="ViewModels\**\*.cs" />
    <Compile Include="TestSupport\**\*.cs" />
    <Compile Include="..\MyBandApp\Models\**\*.cs" Link="MyBandApp\Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\MyBandApp\Extensions\DurationFormatter.cs" Link="MyBandApp\Extensions\DurationFormatter.cs" />
    <Compile Include="..\MyBandApp\Services\SetlistService.cs" Link="MyBandApp\Services\SetlistService.cs" />
    <Compile Include="..\MyBandApp\Services\SongService.cs" Link="MyBandApp\Services\SongService.cs" />
    <Compile Include="..\MyBandApp\ViewModels\**\*.cs" Link="MyBandApp\ViewModels\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
